{
  "name": "rash-studio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A Rust and SVG animation studio for the open web",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/ui.mjs",
    "test:exports": "node tests/exports-browser.mjs",
    "test:runtime": "node tests/runtime-browser.mjs",
    "setup:legacy": "node scripts/vendor-ruffle.mjs",
    "build": "node scripts/build.mjs",
    "build:wasm": "sh scripts/build-wasm.sh",
    "bench": "node scripts/benchmark.mjs",
    "test:mobile": "node tests/mobile-browser.mjs",
    "test:workflows": "node tests/workflows-browser.mjs",
    "test:embed-game": "node tests/embed-game-browser.mjs",
    "test:motion": "node tests/motion-browser.mjs",
    "test:rollback": "node tests/rollback-browser.mjs",
    "build:three": "node scripts/vendor-three.mjs",
    "test:camera": "node tests/camera-browser.mjs",
    "test:masks": "node tests/masks-browser.mjs",
    "examples:generate": "node scripts/generate-examples.mjs",
    "test:examples": "node tests/examples-browser.mjs",
    "header:generate": "node scripts/generate-header.mjs",
    "test:header": "node tests/header-browser.mjs",
    "readme:generate": "node scripts/generate-readme-art.mjs",
    "test:readme-art": "node tests/readme-art-browser.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "three": "0.186.1"
  }
}
