{
  "name": "@ruv/rash",
  "version": "0.6.0",
  "type": "module",
  "description": "Rust, WebAssembly and SVG animation studio for the open web",
  "keywords": [
    "svg",
    "animation",
    "wasm",
    "rust",
    "flash",
    "actionscript",
    "mcp",
    "threejs"
  ],
  "author": "ruvnet",
  "homepage": "https://ruvnet.github.io/Rash/",
  "bugs": "https://github.com/ruvnet/Rash/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/Rash.git"
  },
  "funding": "https://github.com/sponsors/ruvnet",
  "bin": {
    "rash": "bin/rash.mjs",
    "rash-mcp": "mcp/server.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./model": "./web/core/model.js",
    "./renderer": "./web/core/renderer.js",
    "./export": "./web/export/export.js",
    "./embed": "./web/embed.js",
    "./mcp": "./mcp/server.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    ".claude-plugin",
    "bin",
    "cloud",
    "docs",
    "index.js",
    "mcp",
    "pkg",
    "skills",
    "web",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node bin/rash.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/ui.mjs",
    "test:exports": "node tests/exports-browser.mjs",
    "test:runtime": "node tests/runtime-browser.mjs",
    "setup:legacy": "node scripts/vendor-ruffle.mjs",
    "build": "node scripts/build.mjs",
    "build:wasm": "sh scripts/build-wasm.sh",
    "bench": "node scripts/benchmark.mjs",
    "bench:symbols": "node scripts/benchmark-symbols.mjs",
    "test:mobile": "node tests/mobile-browser.mjs",
    "test:workflows": "node tests/workflows-browser.mjs",
    "test:embed-game": "node tests/embed-game-browser.mjs",
    "test:motion": "node tests/motion-browser.mjs",
    "test:rollback": "node tests/rollback-browser.mjs",
    "build:three": "node scripts/vendor-three.mjs",
    "test:camera": "node tests/camera-browser.mjs",
    "test:masks": "node tests/masks-browser.mjs",
    "examples:generate": "node scripts/generate-examples.mjs",
    "test:examples": "node tests/examples-browser.mjs",
    "header:generate": "node scripts/generate-header.mjs",
    "test:header": "node tests/header-browser.mjs",
    "readme:generate": "node scripts/generate-readme-art.mjs",
    "test:readme-art": "node tests/readme-art-browser.mjs",
    "test:symbols": "node tests/symbols-browser.mjs",
    "mcp": "node mcp/server.mjs",
    "test:mcp": "node --test tests/mcp*.test.js",
    "test:mcp-ui": "node tests/mcp-ui-browser.mjs",
    "build:mcp-ui": "node web/mcp/build.mjs",
    "build:mcp-cloud": "node scripts/build-mcp-cloud.mjs",
    "test:studio-cloud": "node tests/studio-cloud-browser.mjs",
    "test:package": "node --test tests/npm-package.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "three": "0.186.1"
  }
}
